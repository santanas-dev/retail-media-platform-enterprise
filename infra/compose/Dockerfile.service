# Shared service Dockerfile for Phase 1 skeletons
#
# Build:  docker build -f infra/compose/Dockerfile.service
#         --build-arg SERVICE_NAME=control-api
#         --build-arg SERVICE_MODULE=apps.control-api.main
#         --build-arg SERVICE_PORT=8000 .
#
# Run:    docker run --rm -e RMP_SERVICE=control-api rmp-control-api

FROM python:3.12-slim

# curl required for Docker healthcheck (all services use curl -f /health/live)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

ARG SERVICE_NAME
ARG SERVICE_MODULE
ARG SERVICE_PORT

ENV RMP_SERVICE=${SERVICE_NAME}
ENV SERVICE_MODULE=${SERVICE_MODULE}

WORKDIR /app

# Copy only what's needed: the service + shared packages
COPY apps/${SERVICE_NAME}/requirements.txt ./apps/${SERVICE_NAME}/
RUN pip install --no-cache-dir -r apps/${SERVICE_NAME}/requirements.txt

COPY packages/ ./packages/
COPY apps/${SERVICE_NAME}/ ./apps/${SERVICE_NAME}/
COPY infra/compose/ ./infra/compose/

# Build identity (build-images.sh passes these). Baked into the image so a
# release's identity can be checked against the image itself
# (verify-pilot-run.sh, docker image inspect). At runtime the pilot compose
# still passes RMP_VERSION/RMP_GIT_SHA/RMP_BUILD_TIME, which override these.
# Unset args stay empty: packages/version.py fails closed on them in pilot.
ARG RMP_VERSION=
ARG RMP_GIT_SHA=
ARG RMP_BUILD_TIME=
ENV RMP_VERSION=${RMP_VERSION}
ENV RMP_GIT_SHA=${RMP_GIT_SHA}
ENV RMP_BUILD_TIME=${RMP_BUILD_TIME}

EXPOSE ${SERVICE_PORT}

CMD ["sh", "-c", "python -c \"import runpy; runpy.run_module('${SERVICE_MODULE}', run_name='__main__')\""]
