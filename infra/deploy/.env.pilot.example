# =============================================================================
# Retail Media Platform — Pilot environment (EXAMPLE ONLY — NO real values)
# =============================================================================
# PILOT-DEPLOYMENT-READINESS-001B (SCOPE E).  Copy to `.env.pilot` and fill in
# real values from the owner inputs (001A).  NEVER commit `.env.pilot`.
#
# The `scripts/deploy/validate-pilot-env.py` script rejects dev defaults,
# weak/short secrets, and dev-only flags.  Run it before any deploy.
# =============================================================================

# --- Environment -------------------------------------------------------------
# pilot | production | staging.  Build metadata is mandatory in these.
ENVIRONMENT=pilot

# --- Immutable version identity (injected by packaging, overridable) ---------
RMP_VERSION=v0.11.0-pilot-control-plane
RMP_GIT_SHA=e13020768c7cc1c2358ff03713baf32fc6ae409c
RMP_BUILD_TIME=REPLACE_WITH_ISO8601_UTC
RMP_SCHEMA_HEAD=034

# --- PostgreSQL --------------------------------------------------------------
# Owner role (migrations/seed) — NOT the app runtime role.
POSTGRES_OWNER_USER=retail_media_owner
POSTGRES_OWNER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# App runtime role (NOBYPASSRLS) — DML only.
POSTGRES_APP_USER=retail_media_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=retail_media_platform
# App-runtime DATABASE_URL uses the app role:
# DATABASE_URL=postgresql+asyncpg://retail_media_app:<app-pass>@postgres:5432/retail_media_platform
DATABASE_URL=postgresql+asyncpg://retail_media_app:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/retail_media_platform
# Migration job DATABASE_URL uses the owner role:
MIGRATION_DATABASE_URL=postgresql+asyncpg://retail_media_owner:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/retail_media_platform

# --- JWT / session -----------------------------------------------------------
# ≥32 chars, openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_AUDIENCE=rmp-control-api

# --- Manifest signing --------------------------------------------------------
# ≥32 chars, openssl rand -hex 32
MANIFEST_SIGNING_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=REPLACE_WITH_STRONG_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_SECRET_KEY
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=REPLACE_WITH_PUBLIC_MINIO_HOST_OR_PROXY
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY
CREATIVE_STORAGE_BUCKET=retail-media-creatives
CONTRACT_STORAGE_BUCKET=retail-media-contracts

# --- Public URLs / CORS ------------------------------------------------------
# Real pilot domains only — no localhost/127.0.0.1 (validator rejects them).
CORS_ALLOWED_ORIGINS=REPLACE_WITH_HTTPS_PILOT_DOMAINS_COMMA_SEPARATED
CORS_ALLOW_CREDENTIALS=true

# --- Metrics -----------------------------------------------------------------
# ≥16 chars, shared with Prometheus scrape (Authorization: Bearer <token>)
METRICS_AUTH_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- AD / SMTP (only if enabled in pilot; leave empty if disabled) -----------
# AD_ENABLED=false
# AD_SERVER_URL=ldaps://REPLACE
# AD_BASE_DN=REPLACE
# AD_USER_SEARCH_BASE=REPLACE
# AD_BIND_DN=REPLACE
# AD_BIND_PASSWORD=REPLACE
# AD_CA_CERT_FILE=REPLACE
# SMTP_HOST=REPLACE
# SMTP_PORT=587

# --- Seed / dev-only flags (MUST be false in pilot) --------------------------
SEED_DEV_CREDENTIALS=false
LICENSE_DEV_INGEST_ENABLED=false

# --- Admin / advertiser bootstrap credentials --------------------------------
# Real operator passwords, NOT the dev defaults.  Provided as bcrypt hashes or
# via the seed mechanism in 001E.  See docs/runbook/clean-install-login.md.
# SEED_ADMIN_PASSWORD_HASH=REPLACE
# SEED_ADVERTISER_PASSWORD_HASH=REPLACE

# --- Backup destination (001C) ----------------------------------------------
BACKUP_DIR=/backups
# BACKUP_S3_ENDPOINT=REPLACE
# BACKUP_S3_ACCESS_KEY=REPLACE
# BACKUP_S3_SECRET_KEY=REPLACE

# --- Immutable image references (from images.lock.json) ---------------------
# Each app image is pinned to repository@sha256:<digest>. NO mutable tags.
# Fill real digests from `scripts/deploy/build-images.sh --push` output and
# validate with `scripts/deploy/validate-image-lock.py`.
CONTROL_API_IMAGE=ghcr.io/santanas-dev/retail-media-platform-enterprise/control-api@sha256:REPLACE_WITH_REAL_DIGEST
DEVICE_GATEWAY_IMAGE=ghcr.io/santanas-dev/retail-media-platform-enterprise/device-gateway@sha256:REPLACE_WITH_REAL_DIGEST
ORCHESTRATOR_WORKER_IMAGE=ghcr.io/santanas-dev/retail-media-platform-enterprise/orchestrator-worker@sha256:REPLACE_WITH_REAL_DIGEST
ADMIN_WEB_IMAGE=ghcr.io/santanas-dev/retail-media-platform-enterprise/admin-web@sha256:REPLACE_WITH_REAL_DIGEST
ADVERTISER_WEB_IMAGE=ghcr.io/santanas-dev/retail-media-platform-enterprise/advertiser-web@sha256:REPLACE_WITH_REAL_DIGEST

